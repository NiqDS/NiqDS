# Copy to .env and edit. The app runs with NONE of this set — the default is the
# offline `mock` backend, which needs no API key.

# LLM backend: mock (default, offline) | anthropic | openai
LLM_BACKEND=mock

# Only needed when LLM_BACKEND=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# Only needed when LLM_BACKEND=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
