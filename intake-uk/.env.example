# Copy to .env and edit. The app runs with NONE of this set — the default is the
# offline `mock` backend, which needs no API key.

# LLM backend: mock (default, offline) | anthropic | openai
LLM_BACKEND=mock

# Only needed when LLM_BACKEND=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# Only needed when LLM_BACKEND=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Deployment / hardening (safe defaults for local; set these in production) ---
# Stable secret that signs session cookies & API tokens (openssl rand -hex 32).
# INTAKE_SECRET=change-me-to-a-long-random-string
# Where the SQLite db, uploads, scans and session key live (mount a volume here).
# INTAKE_DATA_DIR=/data
# Auto-delete stored client files older than N days (0 = keep forever).
# INTAKE_RETENTION_DAYS=30
# Mark cookies Secure and send HSTS — turn on when served over HTTPS.
# INTAKE_SESSION_SECURE=1
# INTAKE_HSTS=1
# Max upload size in MB (default 25).
# INTAKE_MAX_UPLOAD_MB=25

# --- Connect a work mailbox (email drafts); see docs/setup/oauth-setup.md ---
# Public base for OAuth callbacks (must match the registered redirect URIs).
# OAUTH_REDIRECT_BASE=https://your-domain
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
# MS_CLIENT_ID=...
# MS_CLIENT_SECRET=...
