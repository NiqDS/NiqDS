# Copy to .env for local dev. NEVER commit a real .env. Secrets come from the
# environment / a secret manager in every deployed environment.

# --- Server ---
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://safeword:safeword@localhost:5432/safeword

# --- Redis (sessions / rate limiting / future streaming coordination) ---
REDIS_URL=redis://localhost:6379

# --- JWT (backend-issued access/refresh tokens) ---
# Generate a strong random secret, e.g. `openssl rand -base64 48`.
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- Sign in with Apple ---
# Your app's bundle ID is the "audience" of Apple identity tokens.
APPLE_CLIENT_ID=com.example.safeword
# Apple's issuer + JWKS are fixed; here for clarity / testability.
APPLE_ISSUER=https://appleid.apple.com
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys

# --- Object storage (S3-compatible; M4+) ---
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=safeword-recordings
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Defaults (Open Decision #4) ---
DEFAULT_RECORDING_SECONDS=300
DEFAULT_RETENTION_DAYS=30
